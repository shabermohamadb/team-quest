# ==============================================================================
# TEAM QUEST — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client / Vercel Deployment)
# ------------------------------------------------------------------------------
# In production on Vercel, set VITE_REALTIME_URL to your deployed backend URL.
# Supports both https:// and wss:// formats.
# Examples:
#   VITE_REALTIME_URL=https://team-quest-backend.onrender.com
#   NEXT_PUBLIC_REALTIME_URL=https://team-quest-backend.onrender.com
VITE_REALTIME_URL=
NEXT_PUBLIC_REALTIME_URL=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Node.js Server Runtime: Render, Railway, VPS, etc.)
# ------------------------------------------------------------------------------
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to allowing *.vercel.app preview URLs and local development.
ALLOWED_ORIGINS=https://team-quest.vercel.app,http://localhost:5173,http://localhost:5000

# Optional: Durable session file storage path (defaults to data/active_game_session.json)
STORAGE_FILE=data/active_game_session.json
